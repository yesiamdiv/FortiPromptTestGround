# ============================================================
# FortiPrompt — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=adversarial_testing

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── LLM Providers ────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Logging / Debug ──────────────────────────────────────────
# Set DEBUG_ENABLED=true to activate the structured console logger
DEBUG_ENABLED=false
# Minimum log level shown when DEBUG_ENABLED=true
# Options: trace | debug | info | warning | error | critical
LOG_LEVEL=warning
